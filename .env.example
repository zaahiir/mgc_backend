# Copy to .env and fill in. NEVER commit the real .env.
#
# Every value below was previously hard-coded in mgc/settings.py and is now in
# git history. Treat all of them as compromised and issue new ones before this
# file is used in production.

# 'production' or 'development'. Defaults to production when unset.
DJANGO_ENVIRONMENT=production

# Generate a fresh one:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Rotating this also invalidates every issued JWT, which is intended.
DJANGO_SECRET_KEY=

# Database (MySQL in production)
DJANGO_DB_NAME=admin_mgc
DJANGO_DB_USER=mgc_admin
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=localhost
DJANGO_DB_PORT=3306

# SMTP. Use a Gmail App Password, not the account password.
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=True
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=

# Comma-separated. Override only if the deployment adds a hostname.
DJANGO_ALLOWED_HOSTS=mastergolfclub.com,www.mastergolfclub.com,admin.mastergolfclub.com,member.mastergolfclub.com
DJANGO_CORS_ALLOWED_ORIGINS=https://mastergolfclub.com,https://www.mastergolfclub.com,https://admin.mastergolfclub.com,https://member.mastergolfclub.com

DJANGO_FRONTEND_URL=https://member.mastergolfclub.com

# Optional tuning
DJANGO_MAX_UPLOAD_SIZE=5242880
DJANGO_THROTTLE_ANON=60/min
DJANGO_THROTTLE_USER=1000/hour
